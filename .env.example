# Optional for future LAN / ROS operation. Values are not automatically loaded.
# Set these as environment variables before starting the backend.
SPARK_CONTROL_TOKEN=replace-with-a-random-controller-token
SPARK_BRIDGE_TOKEN=replace-with-a-different-random-bridge-token
# SPARK_MODEL=F:/Code/Project/Project15/spark-freeze/models/yolov8n-pose.pt
# SPARK_DATA_DIR=F:/Code/Project/Project15/spark-freeze/data
# Default app is SPARK Blocks. Keep its mutable data separate from old deployments.
# SPARK_BLOCKS_DATA_DIR=F:/Code/Project/Project15/spark-freeze/data/blocks
# SPARK_PROJECT=blocks
# Use SPARK_PROJECT=freeze only to run the historical referee application.
# Cloud building assistant: read-only structured task context, no actuator tools.
# SPARK_AI_KEY=replace-with-your-provider-key
# SPARK_AI_BASE_URL=https://api.deepseek.com
# SPARK_AI_MODEL=replace-with-an-available-model
# SPARK_AI_DISABLED=1
# SPARK_AI_CONFIG=absolute/path/to/private-ai-config.json
