<?xml version="1.0"?>
<package format="2">
  <name>spark_freeze_bridge</name>
  <version>0.1.0</version>
  <description>Optional, hardware-unverified ROS Noetic adapter for SPARK Freeze.</description>
  <maintainer email="maintainer@example.invalid">SPARK Freeze contributors</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>rospy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <exec_depend>python3-requests</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>alsa-utils</exec_depend>
  <export/>
</package>
